{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Cypress Current Test",
      "type": "shell",
      "command": "npx",
      "args": ["cypress", "run", "--spec", "${relativeFile}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
